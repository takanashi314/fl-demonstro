# 環境変数のひな形。このファイルを .env という名前でコピーして使う。
#   cp .env.example .env
# .env には秘密の値を書くので Git にコミットしないこと（このファイルはコミットしてよい）。

# ---- 必ず設定するもの ----

# Flask アプリの場所
FLASK_APP=fl_demonstro

# 使う設定（development / production）。未設定なら production。
APP_ENV=development

# デバッグモード（1 で有効）。本番では書かないか 0 にすること。
FLASK_DEBUG=1

# セッションや CSRF トークンの署名に使う秘密の鍵。空のままだと起動時にエラーになる。
# 次のコマンドで作った値を貼り付ける:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- 必要なときだけ設定するもの（行頭の # を外して使う） ----

# データベースの場所。未設定なら instance/app.db（SQLite）を使う。
# DATABASE_URL=sqlite:///app.db

# Redis の場所（セッションと送信回数の記録に使う）。未設定なら Redis を使わない。
# REDIS_URL=redis://localhost:6379/0

# 送信回数の記録場所。未設定なら REDIS_URL、それもなければメモリを使う。
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# instance フォルダ（データベースなどを置く場所）。未設定ならプロジェクト直下の instance/。
# INSTANCE_PATH=/app/instance

# 本番設定（APP_ENV=production）で、http のまま試すときだけ false にする。
# SESSION_COOKIE_SECURE=false

# リバースプロキシ（nginx など）の後ろで公開するときだけ、その数を書く（README 参照）。
# 直接つながる状態で 1 以上にすると回数制限をすり抜けられるので注意。
# TRUSTED_PROXY_COUNT=0
